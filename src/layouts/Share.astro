---
// Shell for the sharing pages: /wolts, /rangers, /dam.
interface Props { title: string; description: string; path: string; canonical?: string; ogImage?: string }
const { title, description, path, canonical, ogImage } = Astro.props;
const site = 'https://woltspace.com';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | woltspace</title>
  <meta name="description" content={description}>
  <link rel="icon" href="/favicon.svg">
  <link rel="canonical" href={site + (canonical ?? path)}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={site + path}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  {ogImage && <meta property="og:image" content={site + ogImage}>}
  {ogImage && <meta property="og:image:width" content="1200">}
  {ogImage && <meta property="og:image:height" content="630">}
  {ogImage && <meta name="twitter:card" content="summary_large_image">}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600&family=JetBrains+Mono&family=Preahvihear&display=swap" rel="stylesheet">
</head>
<body>
<main>
  <slot />
</main>
<script is:inline>
  document.querySelectorAll('[data-copy]').forEach((button) => button.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(document.getElementById(button.dataset.copy).textContent); button.textContent = 'Copied'; }
    catch { button.textContent = 'Select & copy'; }
    setTimeout(() => { button.textContent = 'Copy'; }, 1500);
  }));
</script>
</body>
</html>

<style is:global>
  :root { --bg: #FAF7F0; --ink: #18100A; --soft: #5C4D3C; --line: #D6CCBA; --card: #F5F1E8; --accent: #C4531E; --green: #3A6644; --warn-bg: #FFF1C9; --warn-line: #D9A400; --warn-ink: #4A3500; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #1a130d; --ink: #F5EFE4; --soft: #c2b39e; --line: #5c4a38; --card: #231a12; --accent: #e07a45; --green: #8fc29b; --warn-bg: #3a2c05; --warn-line: #b88a00; --warn-ink: #ffe9a8; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 17px/1.6 'DM Sans', sans-serif; }
  main { max-width: 680px; margin: 0 auto; padding: 48px 16px 80px; }
  a { color: var(--accent); }
  .back { font-size: 14px; color: var(--soft); overflow-wrap: anywhere; }
  .back a { color: var(--soft); text-decoration: none; }
  .back a:hover { text-decoration: underline; }
  h1 { font-family: 'Preahvihear', sans-serif; font-weight: 400; font-size: 44px; line-height: 1.15; margin: 24px 0 4px; overflow-wrap: anywhere; }
  .lead { color: var(--soft); margin: 0 0 16px; }
  .part { font-family: 'Preahvihear', sans-serif; font-weight: 400; font-size: 26px; margin: 40px 0 12px; }
  .paste { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 20px; margin-top: 16px; }
  .paste p { margin: 0 0 12px; }
  .paste ul { margin: 0; padding-left: 20px; }
  .row { display: flex; gap: 8px; align-items: stretch; flex-wrap: wrap; }
  code, .cmd { font-family: 'JetBrains Mono', monospace; font-size: 14px; }
  .cmd { flex: 1 1 260px; background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; overflow-wrap: anywhere; }
  button { font: 600 15px 'DM Sans', sans-serif; background: var(--accent); color: #fff; border: 0; border-radius: 10px; padding: 10px 18px; cursor: pointer; }
  .hint { font-size: 14px; color: var(--soft); margin: 12px 0 0; }
  .paste p.hint { margin: 12px 0 0; }
  hr { border: 0; border-top: 1px solid var(--line); margin: 48px 0 32px; }

  .by { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 15px; color: var(--soft); margin: 0 0 24px; }
  .by img { width: 24px; height: 24px; border-radius: 50%; }
  .badge { display: inline-block; font-size: 12px; font-weight: 600; border-radius: 99px; padding: 2px 10px; border: 1px solid var(--line); color: var(--soft); white-space: nowrap; }
  .badge.ranger { background: var(--green); border-color: var(--green); color: #fff; }
  @media (prefers-color-scheme: dark) { .badge.ranger { color: #10200f; } }
  .badge.official { border-color: var(--green); color: var(--green); }
  .badge.unverified { background: var(--warn-bg); border-color: var(--warn-line); color: var(--warn-ink); }

  .warn { background: var(--warn-bg); border: 2px solid var(--warn-line); color: var(--warn-ink); border-radius: 14px; padding: 16px 18px; margin: 20px 0 8px; }
  .warn strong { display: block; font-size: 18px; margin-bottom: 4px; }
  .warn p { margin: 6px 0 0; }

  .facts { width: 100%; border-collapse: collapse; font-size: 15px; }
  .facts td { padding: 8px 0; border-bottom: 1px solid var(--line); vertical-align: top; overflow-wrap: anywhere; }
  .facts td:first-child { color: var(--soft); width: 110px; padding-right: 12px; }

  .list { list-style: none; padding: 0; margin: 0; }
  .item { display: block; text-decoration: none; color: inherit; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; margin: 10px 0; }
  a.item:hover { border-color: var(--accent); }
  .item .top { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .item .name { font-weight: 600; font-size: 18px; overflow-wrap: anywhere; }
  .item .name span { color: var(--soft); font-weight: 400; }
  .item p { margin: 4px 0 0; color: var(--soft); font-size: 15px; }
  .item .meta { font-size: 13px; color: var(--soft); margin-top: 8px; }
  .empty { border: 1px dashed var(--line); border-radius: 14px; padding: 16px; color: var(--soft); font-size: 15px; }

  .profile { display: flex; gap: 16px; align-items: center; margin: 24px 0 8px; }
  .profile img { width: 84px; height: 84px; border-radius: 50%; border: 1px solid var(--line); }
  .profile h1 { margin: 0 0 4px; font-size: 36px; }

  .for-ai summary { cursor: pointer; list-style: none; display: flex; align-items: center; gap: 10px; }
  .for-ai summary::-webkit-details-marker { display: none; }
  .for-ai summary::after { content: '▸'; color: var(--soft); font-size: 20px; transition: transform .15s; }
  .for-ai[open] summary::after { transform: rotate(90deg); }
  .for-ai summary .part { margin: 0; }
  .for-ai h3 { font-size: 19px; margin: 28px 0 8px; }
  .for-ai blockquote { margin: 12px 0; padding: 8px 16px; border-left: 3px solid var(--warn-line); background: var(--card); border-radius: 0 10px 10px 0; }
  .for-ai li { margin: 6px 0; overflow-wrap: anywhere; }
</style>
