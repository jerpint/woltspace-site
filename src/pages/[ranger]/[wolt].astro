---
import WoltPage from '../../components/WoltPage.astro';
import { loadShare, woltPath } from '../../lib/registry';

export async function getStaticPaths() {
  const { rangers } = await loadShare();
  return rangers.flatMap((ranger) => ranger.wolts.map((wolt) => ({
    params: { ranger: wolt.ranger, wolt: wolt.name }, props: { wolt },
  })));
}
const { wolt } = Astro.props;
---
<WoltPage wolt={wolt} path={woltPath(wolt.ranger, wolt.name)} />
