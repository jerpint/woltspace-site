---
import Page from '../../layouts/Page.astro';
import { loadShare, rangerPath } from '../../lib/registry';
const { rangers } = await loadShare();
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
---
<Page title="Rangers" description="The people who share wolts and apps on Woltspace." path="/rangers" wide>
  <p class="back"><a href="/">woltspace</a> / rangers</p>
  <div class="list-head"><h1>Rangers</h1><span class="count">{rangers.length}</span></div>
  <p class="lead">The people who share wolts and apps. A ranger is a GitHub account.</p>
  <ul class="cards">
    {rangers.map((ranger) => (
      <li><a class="card" href={rangerPath(ranger.login)}>
        <img class="card-avatar" src={`https://github.com/${ranger.login}.png?size=96`} alt="" width="48" height="48">
        <div class="card-body">
          <p class="card-name"><b>{ranger.login}</b></p>
          <p class="card-line">{ranger.badge ? `🌲 ${ranger.badge}` : 'Ranger'}</p>
          <p class="card-meta"><span>{plural(ranger.wolts.length, 'wolt')}</span><span>{plural(ranger.apps.length, 'app')}</span></p>
        </div>
      </a></li>
    ))}
  </ul>
</Page>
