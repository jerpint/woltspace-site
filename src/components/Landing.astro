---
// The landing page, rendered inside Starlight's frame (see src/content/docs/index.mdx).
// Markup + scripts moved verbatim from the old standalone landing.html;
// styles live in src/styles/landing.css, palette tokens in woltspace.css.
import '../styles/landing.css';
---
<div class="ws-landing">
<div id="bg-nature-wrap">
  <div id="bg-nature"></div>
  <div id="river-dots"></div>
  <div class="cloud-layer">
    <div class="cloud" id="cl-1"></div>
    <div class="cloud" id="cl-2"></div>
    <div class="cloud" id="cl-3"></div>
    <div class="cloud" id="cl-4"></div>
    <div class="cloud" id="cl-5"></div>
    <div class="cloud" id="cl-6"></div>
  </div>
  <div class="scene-critter scene-beaver" id="sc-beaver1" style="left:15%"></div>
  <div class="scene-critter scene-raccoon" id="sc-raccoon1" style="left:42%"></div>
  <div class="scene-critter scene-otter-swim" id="sc-otter1"></div>
</div>
<div class="page-wrap">
  <header class="site-header">
    <div class="brand">
      <span class="brand-emoji">🦫</span>
      <h1 class="brand-name">woltspace</h1>
    </div>
    <p class="brand-tagline">gnaw. build. repeat.</p>
  </header>
<section style="margin-top:0;margin-bottom:48px">
    <p style="font-size:19px;line-height:1.5;color:var(--ink-2);font-weight:300"><span class="ws-brand-word">woltspace</span> is an orchestration layer for your <s style="text-decoration-color:var(--ink-3);text-decoration-thickness:1.5px">coding agents</s> wolts. You bring the ideas, they do the work. Wolts are always ready to pick up where you left off.</p>
  </section>

  <div class="install-card">
  <div class="install-block" style="margin:0;animation:none">
    <div class="install-label">Run this in your terminal to get started</div>
    <div class="install-cmd">
      <code><span class="prompt">$</span>curl -fsSL https://woltspace.com/install.sh | bash</code>
      <button class="copy-btn" onclick="copyInstall()"><span id="copy-label">Copy</span></button>
    </div>

    <details class="prereq">
      <summary class="prereq-summary">
        <span class="prereq-summary-icon">🐳</span>
        <span class="prereq-summary-text"><strong>New to all this?</strong> How to install Docker and open a terminal</span>
        <span class="prereq-summary-caret">▼</span>
      </summary>
      <div class="prereq-detail">
        <div class="prereq-steps">
          <div class="prereq-step">
            <div class="prereq-step-num">1</div>
            <div class="prereq-step-text"><strong>Download Docker Desktop</strong>: free, works on Mac, Windows, and Linux. <a href="https://www.docker.com/products/docker-desktop/" target="_blank" rel="noopener" style="color:var(--terra);border-bottom:1px solid rgba(196,83,30,0.35);text-decoration:none">Get it here →</a></div>
          </div>
          <div class="prereq-step">
            <div class="prereq-step-num">2</div>
            <div class="prereq-step-text"><strong>Install and open it.</strong> A small whale icon will appear in your menu bar. That means it's running.</div>
          </div>
          <div class="prereq-step">
            <div class="prereq-step-num">3</div>
            <div class="prereq-step-text"><strong>Open your terminal.</strong>
              <div class="terminal-os-tabs" style="margin-top:10px">
                <button class="terminal-os-tab" data-os="mac" onclick="switchOS('mac')">Mac</button>
                <button class="terminal-os-tab" data-os="win" onclick="switchOS('win')">Windows</button>
                <button class="terminal-os-tab" data-os="linux" onclick="switchOS('linux')">Linux</button>
              </div>
              <div class="terminal-os-panel" id="os-mac" style="margin-top:8px">
                <div class="terminal-shortcut">
                  <div class="terminal-shortcut-keys"><span class="kbd">⌘</span><span style="color:var(--ink-3);font-size:11px">+</span><span class="kbd">Space</span></div>
                  <div class="terminal-shortcut-desc">Open Spotlight, type <strong>Terminal</strong>, press Enter. Or find it in Applications → Utilities → Terminal.</div>
                </div>
              </div>
              <div class="terminal-os-panel" id="os-win" style="margin-top:8px">
                <div class="terminal-shortcut">
                  <div class="terminal-shortcut-keys"><span class="kbd">Win</span><span style="color:var(--ink-3);font-size:11px">+</span><span class="kbd">R</span></div>
                  <div class="terminal-shortcut-desc">Type <strong>powershell</strong> and press Enter. Or search "PowerShell" in the Start menu. Note: you may need to install <a href="https://docs.microsoft.com/windows/wsl/" target="_blank" rel="noopener" style="color:var(--terra)">WSL</a> first for this command to work on Windows.</div>
                </div>
              </div>
              <div class="terminal-os-panel" id="os-linux" style="margin-top:8px">
                <div class="terminal-shortcut">
                  <div class="terminal-shortcut-keys"><span class="kbd">Ctrl</span><span style="color:var(--ink-3);font-size:11px">+</span><span class="kbd">Alt</span><span style="color:var(--ink-3);font-size:11px">+</span><span class="kbd">T</span></div>
                  <div class="terminal-shortcut-desc">Opens a terminal on most Linux desktops. Or right-click the desktop and look for "Open Terminal".</div>
                </div>
              </div>
            </div>
          </div>
          <div class="prereq-step">
            <div class="prereq-step-num">4</div>
            <div class="prereq-step-text"><strong>Run the command above in your terminal.</strong> That's it.</div>
          </div>
        </div>
      </div>
    </details>
    <p class="github-line" style="margin-top:14px">View source on <a class="github-link" href="https://github.com/jerpint/woltspace">GitHub</a></p>
  </div>
  </div>
  <div class="section-divider"></div>

  <!-- Split view mockup -->
  <div class="split-mockup">
    <div class="split-titlebar">
      <div class="split-dot r"></div><div class="split-dot y"></div><div class="split-dot g"></div>
      <div class="split-titlebar-text">woltspace / the lodge</div>
    </div>
    <div class="split-body">
      <div class="split-terminal" id="mock-terminal">
        <div id="beaver-pixel"></div>
      </div>
      <div class="split-viewport">
        <div class="vp-page">
          <div class="vp-header">🦫 my-wolt</div>
          <div class="vp-card"><span class="vp-badge live">live</span> Site updated just now</div>
          <div class="vp-card"><span class="vp-badge build">building</span> blog project on port 4001</div>
          <div class="vp-card" style="font-size:10px;color:var(--ink-3)">memory: 3 files &middot; sessions: 12 &middot; uptime: 4d</div>
        </div>
        <div id="raccoon-pixel"></div>
        <div id="otter-pixel"></div>
      </div>
    </div>
  </div>

  <section>
    <div class="section-label">Features</div>
    <ul class="principles-grid">
      <li class="principle-card"><div class="principle-title">Persistent wolts</div><p class="principle-desc">Sessions end, wolts don't. Memory, identity, and learnings carry across.</p></li>
      <li class="principle-card"><div class="principle-title">Access anywhere</div><p class="principle-desc">One URL reaches your wolts from any authenticated device. Telegram integration means you can chat with them from anywhere.</p></li>
      <li class="principle-card"><div class="principle-title">Own the infra</div><p class="principle-desc">Runs entirely on your machine. Sandboxed so wolts don't need to ask permission.</p></li>
      <li class="principle-card"><div class="principle-title">Bring your harness</div><p class="principle-desc">Claude, Codex, or your own open source harness. Pick the harness and model per wolt.</p></li>
    </ul>
  </section>
  <section>
    <div class="section-label">If you're a wolt 🦫</div>
    <div class="wolt-callout">
      <p>Welcome. This page is for you too.</p>
      <p style="margin-top:10px">Read <a href="llms.txt">llms.txt</a>. It has the full reference -- install, memory system, projects, scheduling, skills, and everything else your human needs to get you set up.</p>
    </div>
  </section>
  <nav class="main-nav">
    <a class="nav-link" href="/docs/getting-started/">Docs</a>
    <a class="nav-link" href="llms.txt">llms.txt</a>
    <a class="nav-link" href="https://github.com/jerpint/woltspace">GitHub</a>
  </nav>
</div>
<footer><p>🦫 woltspace: give your wolt a lodge.</p></footer>
</div>
<script is:inline>
function copyInstall(){
  var cmd='curl -fsSL https://woltspace.com/install.sh | bash';
  var label=document.getElementById('copy-label');
  function onSuccess(){label.textContent='✓ Copied';setTimeout(function(){label.textContent='Copy'},2000);}
  function onFail(){
    var ta=document.createElement('textarea');
    ta.value=cmd;
    ta.style.cssText='position:fixed;top:0;left:0;opacity:0;pointer-events:none';
    document.body.appendChild(ta);
    ta.focus();ta.select();
    try{document.execCommand('copy');onSuccess();}catch(e){}
    document.body.removeChild(ta);
  }
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(cmd).then(onSuccess,onFail);
  } else {
    onFail();
  }
}

// Detect platform and activate the right OS tab
(function(){
  var ua=navigator.userAgent;
  var os=ua.indexOf('Mac')>-1?'mac':ua.indexOf('Win')>-1?'win':'linux';
  switchOS(os);
})();

function switchOS(os){
  document.querySelectorAll('.terminal-os-tab').forEach(function(t){
    t.classList.toggle('active', t.dataset.os===os);
  });
  document.querySelectorAll('.terminal-os-panel').forEach(function(p){
    p.classList.toggle('active', p.id==='os-'+os);
  });
}

// 🦫 console easter egg
console.log('🦫 wolt beaver builder');
console.log('gnaw. build. repeat.\nwoltspace.com');

// 🦫 click h1 five times for beaver mode
const h1=document.querySelector('.brand-name');let bClicks=0,bTimer;
h1.addEventListener('click',()=>{bClicks++;clearTimeout(bTimer);bTimer=setTimeout(()=>{bClicks=0},1500);if(bClicks>=5){bClicks=0;document.querySelector('.brand-tagline').textContent='🦫🦫🦫 BEAVER MODE 🦫🦫🦫';for(let i=0;i<20;i++){setTimeout(()=>{const b=document.createElement('span');b.textContent='🦫';b.style.cssText=`position:fixed;font-size:${1.5+Math.random()*2}rem;left:${Math.random()*95}vw;top:-3rem;pointer-events:none;z-index:9999;animation:beavFall ${2+Math.random()*2}s linear forwards;`;document.body.appendChild(b);setTimeout(()=>b.remove(),5000)},i*100)}}});

// Procedural pixel art landscape
(function(){var S=5,W=Math.ceil(window.innerWidth/S)+6,H=42,BANK=28,RIVER=34;
var C={fa:'#8AA6BA',fb:'#6A8698',na:'#3E5A32',nb:'#293E20',ta:'#3A7030',tb:'#2A5225',tc:'#1A3A18',tt:'#4A2810',ga:'#72B855',gb:'#4A8838',gc:'#2A5A1A',ea:'#5A4020',eb:'#3A2810',ra:'#90D4E8',rb:'#4AAAC8',rc:'#2A7AAA',rd:'#1A5888',ba:'#3A7030'};
function dot(x,y,c){return'<rect x="'+(x*S)+'" y="'+(y*S)+'" width="'+S+'" height="'+S+'" fill="'+c+'"/>';}
var fp=[],np=[];
for(var x=0;x<W;x++){fp[x]=Math.round(7+5*Math.sin(x*0.05+0.3)+3*Math.sin(x*0.12+1.7)+1.5*Math.sin(x*0.04+0.9));np[x]=Math.round(6+6*Math.sin(x*0.08+1.0)+3.5*Math.sin(x*0.16+0.5)+1.5*Math.sin(x*0.22+2.4));}
var out=[];
for(var x=0;x<W;x++){for(var y=0;y<8;y++)out.push(dot(x,y,'#B8D4E8'));}
for(var x=0;x<W;x++){var ft=BANK-16-fp[x];for(var y=Math.max(ft,0);y<BANK;y++)out.push(dot(x,y,y===ft?C.fb:C.fa));}
for(var x=0;x<W;x++){var nt=BANK-2-np[x];for(var y=Math.max(nt,1);y<BANK;y++)out.push(dot(x,y,y===nt?C.nb:C.na));}
for(var x=0;x<W;x++){out.push(dot(x,BANK,C.ga));out.push(dot(x,BANK+1,C.gb));out.push(dot(x,BANK+2,C.gc));out.push(dot(x,BANK+3,C.ea));for(var y=BANK+4;y<RIVER;y++)out.push(dot(x,y,C.eb));}
for(var x=0;x<W;x++){out.push(dot(x,RIVER,C.ba));out.push(dot(x,RIVER+1,C.rc));out.push(dot(x,RIVER+2,C.rc));out.push(dot(x,RIVER+3,C.rd));for(var y=RIVER+4;y<H;y++)out.push(dot(x,y,C.rd));}
function tree(cx,baseY,h){for(var dy=0;dy<h;dy++){var hw=Math.floor((dy+1)*0.55),tc=dy<2?C.ta:(dy<h-2?C.tb:C.tc);for(var dx=-hw;dx<=hw;dx++){var tx=cx+dx;if(tx>=0&&tx<W)out.push(dot(tx,baseY-h+1+dy,tc));}};if(cx>=0&&cx<W){out.push(dot(cx,baseY+1,C.tt));out.push(dot(cx,baseY+2,C.tt));}}
var tx=3;while(tx<W-3){var nt2=BANK-2-np[tx];if(nt2<BANK-7)tree(tx,nt2+Math.floor(np[tx]*0.55),5+((tx*7)%4));tx+=7+((tx*13+5)%5);}

var el=document.getElementById('bg-nature');
if(!el)return;
var svgW=W*S,svgH=H*S;
el.innerHTML='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 '+svgW+' '+svgH+'" preserveAspectRatio="xMidYMid slice" style="image-rendering:pixelated;display:block;width:100%;height:100%" shape-rendering="crispEdges">'+out.join('')+'</svg>';

// Animated river dots
var rd=document.getElementById('river-dots');

function positionDots(){
  var svgEl=el.querySelector('svg');
  if(!svgEl||!rd)return;
  var r=svgEl.getBoundingClientRect();
  if(r.width<1)return;
  var scale=r.width/svgW;
  var dotPx=Math.max(2,Math.round(S*scale));
  var rowTop=Math.round((RIVER+1)*S*scale);
  var tileW=Math.round(3*S*scale);
  var svgBg="<svg xmlns='http://www.w3.org/2000/svg' width='"+tileW+"' height='"+dotPx+"'>"
    +"<rect x='0' y='0' width='"+dotPx+"' height='"+dotPx+"' fill='%2390D4E8'/>"
    +"</svg>";
  var styleEl=document.getElementById('river-kf');
  if(!styleEl){styleEl=document.createElement('style');styleEl.id='river-kf';document.head.appendChild(styleEl);}
  var bottomPct=((H-RIVER-2)/H*100).toFixed(2);
  styleEl.textContent=
    '@keyframes riverDots{from{transform:translateX(0)}to{transform:translateX(-50%)}}'
    +' #river-dots{'
    +'position:absolute;bottom:'+bottomPct+'%;height:'+dotPx+'px;'
    +'left:0;width:200%;'
    +'background-image:url("data:image/svg+xml,'+svgBg+'");'
    +'background-repeat:repeat-x;'
    +'background-size:'+tileW+'px '+dotPx+'px;'
    +'animation:riverDots 90s linear infinite;'
    +'pointer-events:none;'
    +'}';
}

requestAnimationFrame(function(){requestAnimationFrame(positionDots);});
window.addEventListener('resize', positionDots);
})();

// Pixel art clouds
(function(){var CP={O:'#8898A8',w:'#E0E8EE',W:'#F8FCFF',s:'#BCC8D0'};
var SHAPES={lg:['......OOOO...OOOO.......', '.....OwwWwOOOwwWwO......', '....OwWWWWwOwWWWWwO.....', '...OOwWWWWWwwWWWWWwOO...', '..OwwWWWWWWWWWWWWWWwO...', '..OwWWWWWWWWWWWWWWWWwO..', '..OwwWWWWWWWWWWWWWWwwO..', '..OssssssssssssssssssO..', '...OOOOOOOOOOOOOOOOOO...'],
md:['....OOO...OOO......','...OwWwOOOwWwO.....','..OwWWWwOwWWWwO....', '.OOwWWWWwwWWWWwOO..', '.OwwWWWWWWWWWWWwO..', '.OwWWWWWWWWWWWWwO..', '.OwwWWWWWWWWWWwwO..', '.OssssssssssssssO..', '..OOOOOOOOOOOOOO...'],
sm:['...OOO..OOO....','..OwWwOOwWwO...','.OwWWWwwWWWwO..','.OwwWWWWWWwwO..','.OwWWWWWWWWwO..','.OwwWWWWWWwwO..','.OssssssssssO..','..OOOOOOOOOO...']};
function renderCloud(map,px){var cols=Math.max.apply(null,map.map(function(r){return r.length;})),rects=[];for(var r=0;r<map.length;r++)for(var c=0;c<map[r].length;c++){var fill=CP[map[r][c]];if(!fill)continue;rects.push('<rect x="'+(c*px)+'" y="'+(r*px)+'" width="'+px+'" height="'+px+'" fill="'+fill+'"/>');}return'<svg width="'+(cols*px)+'" height="'+(map.length*px)+'" xmlns="http://www.w3.org/2000/svg" style="image-rendering:pixelated;display:block" shape-rendering="crispEdges">'+rects.join('')+'</svg>';}
[{id:'cl-1',shape:'lg',px:7},{id:'cl-2',shape:'md',px:6},{id:'cl-3',shape:'sm',px:6},{id:'cl-4',shape:'lg',px:6},{id:'cl-5',shape:'md',px:5},{id:'cl-6',shape:'sm',px:5}].forEach(function(c){var el=document.getElementById(c.id);if(el)el.innerHTML=renderCloud(SHAPES[c.shape],c.px);});
})();

// Scene critters --beavers, raccoon, otter in the landscape banner
