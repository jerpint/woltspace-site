  var b1=document.getElementById('sc-beaver1');
  if(b1)b1.innerHTML=spriteToSVG(beavMap,beavPal,px);
  var r1=document.getElementById('sc-raccoon1');
  if(r1)r1.innerHTML=spriteToSVG(raccMap,raccPal,px);
  var o1=document.getElementById('sc-otter1');
