---
// The talk page — video + slides from the "scaffold for your harnesses" talk.
// To publish the recording: set YOUTUBE_ID below (the 11-char id from the
// YouTube URL, e.g. "dQw4w9WgXcQ" from youtube.com/watch?v=dQw4w9WgXcQ).
// While it's empty the page shows a "recording coming soon" card instead.
const YOUTUBE_ID = "";

const slides = [
  { file: "slide-01-title", label: "woltspace" },
  { file: "slide-02-thesis", label: "the thesis" },
  { file: "slide-03-harness", label: "harness and scaffold" },
  { file: "slide-04-wolts", label: "the unit" },
  { file: "slide-05-woltspace", label: "the scaffold for your wolts" },
  { file: "slide-06-compute", label: "the compute layer" },
  { file: "slide-07-reach", label: "how you reach them" },
  { file: "slide-08-coordination", label: "coordination" },
  { file: "slide-09-terminal", label: "demo" },
  { file: "slide-10-close", label: "close" },
];
---
<div class="ws-talk">
  <header class="talk-header">
    <p class="talk-kicker">the talk</p>
    <h1 class="talk-title">The scaffold for your harnesses</h1>
    <p class="talk-sub">
      What woltspace is and why it exists, in ten slides and a live demo —
      wolts messaged from a phone on stage, slides served out of the lodge
      they describe.
    </p>
  </header>

  <section class="talk-video">
    {YOUTUBE_ID ? (
      <div class="video-frame">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${YOUTUBE_ID}`}
          title="woltspace — the scaffold for your harnesses (talk recording)"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    ) : (
      <div class="video-frame video-soon">
        <span class="video-soon-emoji">🎬</span>
        <p class="video-soon-text">recording coming soon</p>
        <p class="video-soon-sub">the talk was given live — the video lands here once it's up</p>
      </div>
    )}
  </section>

  <section class="talk-slides">
    <div class="slides-label">The slides</div>
    <div class="slides-grid">
      {slides.map((s, i) => (
        <a class="slide-card" href={`/media/talk/${s.file}.png`} target="_blank" rel="noopener">
          <img src={`/media/talk/${s.file}.png`} alt={`slide ${i + 1} — ${s.label}`} loading={i < 2 ? "eager" : "lazy"} width="2560" height="1440" />
          <span class="slide-caption"><span class="slide-num">{String(i + 1).padStart(2, "0")}</span> {s.label}</span>
        </a>
      ))}
    </div>
  </section>

  <nav class="talk-nav">
    <a class="nav-back" href="/">← woltspace.com</a>
    <a class="nav-back" href="/docs/getting-started/">the docs</a>
    <a class="nav-back" href="https://github.com/jerpint/woltspace">GitHub</a>
  </nav>
</div>

<style is:global>
  /* Same guards the landing uses: hide Starlight's auto-title band and footer
     on this page only (the component carries its own header). */
  main:has(.ws-talk) .content-panel:first-child { display: none; }
  main:has(.ws-talk) .content-panel { padding: 0; border-top: none; }
  main:has(.ws-talk) footer.sl-flex { display: none; }
</style>
<style>
  .ws-talk {
    max-width: 960px;
    margin: 0 auto;
    padding: 48px 20px 80px;
  }
  .talk-header { text-align: center; margin-bottom: 40px; }
  .talk-kicker {
    font-family: var(--__sl-font-mono, monospace);
    font-size: 12px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--sl-color-accent);
    margin: 0 0 12px;
  }
  .talk-title {
    font-family: 'Preahvihear', var(--__sl-font, sans-serif);
    font-weight: 400;
    font-size: clamp(28px, 5vw, 44px);
    line-height: 1.2;
    color: var(--sl-color-white);
    margin: 0 0 16px;
  }
  .talk-sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    max-width: 560px;
    margin: 0 auto;
  }

  .talk-video { margin-bottom: 56px; }
  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: #18100A;
    border: 1px solid var(--sl-color-gray-5);
  }
  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  .video-soon-emoji { font-size: 40px; }
  .video-soon-text {
    font-family: var(--__sl-font-mono, monospace);
    font-size: 14px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #EDE8DE;
    margin: 6px 0 0;
  }
  .video-soon-sub { font-size: 13px; color: #9A8F80; margin: 0; }

  .slides-label {
    font-family: var(--__sl-font-mono, monospace);
    font-size: 12px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    margin-bottom: 16px;
  }
  .slides-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  @media (max-width: 640px) {
    .slides-grid { grid-template-columns: 1fr; }
  }
  .slide-card {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .slide-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
  }
  .slide-card img { display: block; width: 100%; height: auto; }
  .slide-caption {
    display: block;
    padding: 8px 12px;
    font-family: var(--__sl-font-mono, monospace);
    font-size: 11px;
    color: var(--sl-color-gray-2);
  }
  .slide-num { color: var(--sl-color-accent); margin-right: 6px; }

  .talk-nav {
    margin-top: 56px;
    display: flex;
    justify-content: center;
    gap: 28px;
  }
  .nav-back {
    font-family: var(--__sl-font-mono, monospace);
    font-size: 13px;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    border-bottom: 1px solid var(--sl-color-gray-5);
    padding-bottom: 2px;
  }
  .nav-back:hover { color: var(--sl-color-accent); }
</style>
